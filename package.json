{
  "name": "miles-and-moments",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "A travel journal and booking demo built with HTML, CSS and vanilla JavaScript.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "preview:docs": "node scripts/preview-docs.mjs",
    "package:preview": "node scripts/package-release.mjs",
    "test:package": "node --test tests/package.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "sharp": "^0.35.5"
  }
}
